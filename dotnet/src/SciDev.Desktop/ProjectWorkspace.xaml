<UserControl x:Class="SciDev.Desktop.ProjectWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="clr-namespace:SciDev.Desktop"
             Foreground="{DynamicResource WorkbenchText}" PreviewKeyDown="EditorShortcut">
    <Grid Background="{DynamicResource WorkbenchCanvas}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FolderColumn" Width="29*" MaxWidth="364" MinWidth="109"/>
            <ColumnDefinition x:Name="ExplorerHandleColumn" Width="5"/>
            <ColumnDefinition x:Name="EditorColumn" Width="71*" MinWidth="150"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="ExplorerPanel" Background="{DynamicResource WorkbenchPanel}" BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource WorkbenchEdge}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,12,5,3">
                    <Button Content="···" DockPanel.Dock="Right" Click="RefreshTree" Style="{DynamicResource ClassicQuiet}"
                            ToolTip="刷新资源管理器" Foreground="{DynamicResource WorkbenchMuted}" Padding="8,3"/>
                    <Button Content="＋" DockPanel.Dock="Right" Click="CreateFile" Style="{DynamicResource ClassicQuiet}"
                            ToolTip="新建文件" Foreground="{DynamicResource WorkbenchMuted}" Padding="6,3"/>
                    <TextBlock Text="资源管理器" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{DynamicResource WorkbenchMuted}" FontSize="12.7"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="本地  ·  .research" Margin="12,0,0,8"
                           Foreground="{DynamicResource WorkbenchMuted}"/>
            <TextBox x:Name="SearchInput" DockPanel.Dock="Top" Visibility="Collapsed" Margin="7,0,7,5" MinHeight="25"
                     AutomationProperties.Name="查找文件名" ToolTip="按名称或相对路径查找文件"
                     TextChanged="FilterFiles"/>
                <TreeView x:Name="FileTree" BorderThickness="0" Padding="5,0,4,0" Background="Transparent"
                          SelectedItemChanged="SelectFile" AutomationProperties.Name="工作区文件">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Padding" Value="{DynamicResource WorkbenchFileRowPadding}"/>
                            <Setter Property="Foreground" Value="{DynamicResource WorkbenchText}"/>
                        </Style>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>
        </Border>
        <GridSplitter x:Name="ExplorerDivider" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      Background="{DynamicResource WorkbenchCanvas}"/>
        <DockPanel Grid.Column="2" x:Name="EditorDock">
            <Border DockPanel.Dock="Top" Height="40" BorderBrush="{DynamicResource WorkbenchEdge}" BorderThickness="0,0,0,1"
                    Background="{DynamicResource WorkbenchCanvas}" Padding="13,0,7,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SaveButton" Content="保存" Click="SaveFile" Style="{DynamicResource ClassicQuiet}" Padding="8,3"/>
                        <Button Content="查找" Click="FindInEditor" Style="{DynamicResource ClassicQuiet}" Padding="8,3"/>
                        <Button Content="终端" Click="ShowTerminal" Style="{DynamicResource ClassicQuiet}" Padding="8,3"/>
                        <Button x:Name="MoreEditorButton" Content="更多⌄" Click="OpenEditorMenu" Style="{DynamicResource ClassicQuiet}" Padding="8,3"/>
                    </StackPanel>
                    <TextBlock x:Name="FileTitle" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource WorkbenchMuted}"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                </DockPanel>
            </Border>
            <Popup x:Name="EditorMenuPopup" PlacementTarget="{Binding ElementName=MoreEditorButton}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True">
                <Border BorderThickness="1" BorderBrush="{DynamicResource WorkbenchEdge}" Background="{DynamicResource WorkbenchPanel}" Padding="6" CornerRadius="6">
                <StackPanel ButtonBase.Click="DismissEditorMenu">
                    <Button x:Name="SaveAllButton" Content="保存全部" Click="SaveAllFiles" Padding="8,3" Margin="0,0,4,3"/>
                    <Button x:Name="ReloadButton" Content="重读" Click="ReloadFile" Padding="8,3" Margin="0,0,4,3"/>
                    <Button x:Name="CloseButton" Content="关闭文件" Click="CloseFile" Padding="8,3" Margin="0,0,4,3"/>
                    <Button x:Name="SplitButton" Content="分屏" Click="ToggleSplit" Padding="8,3" Margin="0,0,4,3"/>
                    <Button x:Name="DiagnosticToggle" Content="诊断" Click="ToggleDiagnostics" Padding="8,3" Margin="0,0,4,3"/>
                    <Button x:Name="DebugFileButton" Content="调试 (F5)" Click="DebugFile" Padding="8,3" Margin="0,0,4,3"/>
                    <Button x:Name="PythonCompleteButton" Content="补全" ToolTip="Python 补全 (Ctrl+Space)" Click="CompletePython" Padding="8,3" Margin="0,0,4,3"/>
                    <Button x:Name="PythonDefinitionButton" Content="转到定义" ToolTip="Python 定义 (Ctrl+F12)" Click="GoToPythonDefinition" Padding="8,3" Margin="0,0,0,3"/>
                </StackPanel>
                </Border>
            </Popup>
            <TextBlock x:Name="Notice" DockPanel.Dock="Bottom" Margin="8,5" Foreground="{DynamicResource WorkbenchMuted}"
                       TextTrimming="CharacterEllipsis" AutomationProperties.Name="文件操作状态">
                <TextBlock.Style><Style TargetType="TextBlock">
                    <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
            <Border x:Name="DiagnosticPanel" DockPanel.Dock="Bottom" Visibility="Collapsed" Padding="8,5"
                    Background="{DynamicResource WorkbenchSidebar}" BorderBrush="{DynamicResource WorkbenchEdge}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="DiagnosticEnable" DockPanel.Dock="Right" Content="启用本机服务" Click="EnableDiagnostics"
                                Padding="7,3" Margin="6,0,0,0"/>
                        <TextBlock x:Name="DiagnosticStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                                   AutomationProperties.Name="诊断状态"/>
                    </DockPanel>
                    <ListBox x:Name="DiagnosticItems" MaxHeight="154" Margin="0,4,0,0" Padding="1"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="JumpToDiagnostic" KeyDown="DiagnosticKey"
                             AutomationProperties.Name="当前文件的诊断">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel ToolTip="{Binding Diagnostic.Message}">
                                    <TextBlock DockPanel.Dock="Left" Margin="0,0,9,0" FontWeight="SemiBold" Text="{Binding Location}"/>
                                    <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PrimaryColumn" Width="*" MinWidth="105"/>
                    <ColumnDefinition x:Name="SplitColumn" Width="0"/>
                    <ColumnDefinition x:Name="SecondaryColumn" Width="0"/>
                </Grid.ColumnDefinitions>
                <desktop:EditorPane x:Name="PrimaryDocuments" AutomationProperties.Name="左侧编辑器"/>
                <GridSplitter x:Name="SplitHandle" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" Visibility="Collapsed" Background="{DynamicResource WorkbenchEdge}"/>
                <desktop:EditorPane x:Name="SecondaryDocuments" Grid.Column="2" Visibility="Collapsed"
                                    AutomationProperties.Name="右侧编辑器"/>
            </Grid>
        </DockPanel>
        <DockPanel Grid.Column="2" x:Name="WelcomePane" Background="{DynamicResource WorkbenchCanvas}">
            <Border DockPanel.Dock="Top" Height="43" Background="{DynamicResource WorkbenchPanel}">
                <Border HorizontalAlignment="Left" Width="118" Background="{DynamicResource WorkbenchCanvas}"
                        BorderThickness="0,2,1,0" BorderBrush="{DynamicResource WorkbenchAccent}">
                    <TextBlock Text="欢迎页" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
            </Border>
            <Viewbox StretchDirection="DownOnly" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="22,10">
                <StackPanel Width="249">
                    <TextBlock Text="SciDevHarness" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,13"/>
                    <TextBlock x:Name="WelcomeProject" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,13"/>
                    <TextBlock Text="打开文件，专注编码。&#10;右侧 Agent 能读取项目、修改代码并保留开发过程。"
                               Foreground="{DynamicResource WorkbenchMuted}" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,12"/>
                    <Button Click="WelcomeSearch" Style="{DynamicResource ClassicPrimary}" MinHeight="44" Margin="0,0,0,9">
                        <TextBlock Text="打开文件   Ctrl + P" Width="220" TextAlignment="Left"/>
                    </Button>
                    <Button x:Name="WelcomeIndex" Click="OpenIndex" Visibility="Collapsed"
                            Style="{DynamicResource ClassicQuiet}" MinHeight="40" Margin="0,0,0,13">
                        <TextBlock Text="打开 index.html" Width="220" TextAlignment="Left"/>
                    </Button>
                    <TextBlock Text="保存 Ctrl + S&#10;项目搜索 Ctrl + P&#10;发送指令 Ctrl + Enter"
                               Foreground="{DynamicResource WorkbenchMuted}" LineHeight="24"/>
                </StackPanel>
            </Viewbox>
        </DockPanel>
    </Grid>
</UserControl>
