<UserControl x:Class="SciDev.Desktop.DocumentShelf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="clr-namespace:SciDev.Desktop"
             Foreground="{DynamicResource WorkbenchText}">
    <UserControl.Resources>
        <desktop:DocumentSelectionConverter x:Key="DocumentMatches"/>
    </UserControl.Resources>
    <Border Background="{DynamicResource WorkbenchSidebar}" BorderBrush="{DynamicResource WorkbenchEdge}" BorderThickness="0,0,1,0">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="14,12,8,8">
                <Button DockPanel.Dock="Right" Content="×" Click="CloseShelf" Width="26" Padding="0"
                        Style="{DynamicResource ClassicQuiet}" AutomationProperties.Name="收起文件栏"/>
                <TextBlock Text="工作区文件" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </DockPanel>
            <TextBlock x:Name="Notice" DockPanel.Dock="Bottom" Margin="12,8" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource WorkbenchMuted}" Visibility="Collapsed"/>
            <TreeView x:Name="Files" KeyDown="OpenFromKeyboard" Background="Transparent" BorderThickness="0"
                      Padding="6,0,4,0" AutomationProperties.Name="工作区文件树">
                <TreeView.Resources>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Foreground" Value="{DynamicResource WorkbenchText}"/>
                        <Setter Property="Padding" Value="4,5,6,5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TreeViewItem">
                                    <StackPanel>
                                        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                                CornerRadius="7" MinHeight="33" Margin="0,1,0,0">
                                            <DockPanel>
                                                <ToggleButton x:Name="Expand" DockPanel.Dock="Left" Focusable="False" ClickMode="Press" Width="16"
                                                    IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="Transparent">
                                                                <Path x:Name="Chevron" Data="M 0,0 L 3,3 L 0,6" StrokeThickness="1.3"
                                                                      Stroke="{DynamicResource WorkbenchMuted}" HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                                        <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </DockPanel>
                                        </Border>
                                        <ItemsPresenter x:Name="ItemsHost" Margin="13,0,0,0"/>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter TargetName="Expand" Property="Visibility" Value="Hidden"/>
                                        </Trigger>
                                        <Trigger Property="IsExpanded" Value="False">
                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource WorkbenchCanvas}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource WorkbenchCanvas}"/>
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource WorkbenchEdge}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource WorkbenchAccent}"/>
                                        </Trigger>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource DocumentMatches}">
                                                    <Binding Path="Tag.RelativePath" RelativeSource="{RelativeSource Self}"/>
                                                    <Binding Path="ActivePath" RelativeSource="{RelativeSource AncestorType={x:Type desktop:DocumentShelf}}"/>
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource WorkbenchTint}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource WorkbenchAccent}"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.Resources>
            </TreeView>
        </DockPanel>
    </Border>
</UserControl>
