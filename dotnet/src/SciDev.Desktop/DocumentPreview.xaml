<UserControl x:Class="SciDev.Desktop.DocumentPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource WorkbenchText}">
    <DockPanel Background="{DynamicResource WorkbenchCanvas}">
        <Border DockPanel.Dock="Top" Padding="12,7" Background="{DynamicResource WorkbenchPanel}"
                BorderBrush="{DynamicResource WorkbenchEdge}" BorderThickness="1,0,0,1">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="×" Width="27" Padding="0" Click="CloseView"
                            Style="{DynamicResource ClassicQuiet}" AutomationProperties.Name="关闭预览"/>
                    <Button x:Name="FocusReaderButton" DockPanel.Dock="Right" Content="专注阅读" Click="ToggleFocus"
                            Style="{DynamicResource ClassicQuiet}" FontSize="12" Padding="6,2" Margin="2,0"/>
                    <Button x:Name="MarkdownModeButton" DockPanel.Dock="Right" Content="查看源码" Click="SwitchMarkdownMode"
                            Style="{DynamicResource ClassicQuiet}" FontSize="12" Padding="6,2" Visibility="Collapsed"/>
                    <Button x:Name="BackToChat" DockPanel.Dock="Right" Content="返回对话" Click="ReturnToChat"
                            Style="{DynamicResource ClassicQuiet}" Visibility="Collapsed" FontSize="12" Padding="6,2"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="FileTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="15"/>
                        <TextBlock x:Name="FilePath" Foreground="{DynamicResource WorkbenchMuted}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
                <WrapPanel x:Name="ReaderTools" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed"
                           Margin="0,5,0,0">
                    <Button x:Name="PreviousPage" Content="‹" Width="29" Style="{DynamicResource ClassicQuiet}" Click="GoPrevious"
                            AutomationProperties.Name="上一页"/>
                    <TextBlock x:Name="PageLabel" VerticalAlignment="Center" Margin="5,0" MinWidth="44" TextAlignment="Center"/>
                    <Button x:Name="NextPage" Content="›" Width="29" Style="{DynamicResource ClassicQuiet}" Click="GoNext"
                            AutomationProperties.Name="下一页"/>
                    <Button Content="−" Width="29" Style="{DynamicResource ClassicQuiet}" Click="ZoomOut"
                            AutomationProperties.Name="缩小" Margin="5,0,0,0"/>
                    <Button x:Name="ScaleButton" Content="适应宽度" Style="{DynamicResource ClassicQuiet}" Click="FitWidth"
                            AutomationProperties.Name="适应宽度"/>
                    <Button Content="+" Width="29" Style="{DynamicResource ClassicQuiet}" Click="ZoomIn"
                            AutomationProperties.Name="放大"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border BorderBrush="{DynamicResource WorkbenchEdge}" BorderThickness="1,0,0,0">
            <Grid>
                <Border x:Name="TextSheet" Style="{DynamicResource WorkbenchCard}" Margin="14,14,14,12" MaxWidth="820" Visibility="Collapsed">
                    <Grid>
                        <FlowDocumentScrollViewer x:Name="MarkdownView" Visibility="Collapsed" IsToolBarVisible="False"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="Markdown 阅读区"/>
                        <TextBox x:Name="PlainText" Visibility="Collapsed" Padding="24,20" IsReadOnly="True" TextWrapping="Wrap"
                                 BorderThickness="0" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 FontFamily="Consolas, Cascadia Mono" Background="Transparent" AutomationProperties.Name="文本预览"/>
                    </Grid>
                </Border>
                <ScrollViewer x:Name="ImageViewport" Visibility="Collapsed" Padding="16" SizeChanged="ResizeImage"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Border BorderBrush="{DynamicResource WorkbenchEdge}" BorderThickness="1" Background="{DynamicResource WorkbenchPanel}"
                            HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Image x:Name="Picture" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="页面预览"/>
                    </Border>
                </ScrollViewer>
                <TextBlock x:Name="State" Margin="24" Foreground="{DynamicResource WorkbenchMuted}" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
