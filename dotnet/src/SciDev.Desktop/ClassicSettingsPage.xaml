<UserControl x:Class="SciDev.Desktop.ClassicSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource WorkbenchText}" SizeChanged="ResizeCategories">
    <Grid Margin="20,10,14,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,9">
            <Button Content="返回工作区" DockPanel.Dock="Right" Style="{DynamicResource ClassicQuiet}"
                    Margin="0,2,2,0" Click="ReturnToWorkspace"/>
            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <TextBox x:Name="Search" Height="41" Padding="12,5" Style="{DynamicResource SettingsTextInput}"
                     TextChanged="SearchChanged" AutomationProperties.Name="搜索设置"/>
            <TextBlock Text="搜索设置，例如：字体、侧栏、editor font" IsHitTestVisible="False" VerticalAlignment="Center"
                       Margin="13,0" Foreground="{DynamicResource WorkbenchMuted}" Opacity="0.75">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <DockPanel Grid.Row="2" Height="35" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="恢复默认外观" Style="{DynamicResource ClassicQuiet}" Click="RestoreDefaults"/>
            <CheckBox x:Name="Modified" Content="只看已修改" VerticalAlignment="Center" VerticalContentAlignment="Center"
                      Checked="UpdateFilter" Unchecked="UpdateFilter"/>
        </DockPanel>
        <ComboBox x:Name="CompactCategories" Grid.Row="3" MinHeight="36" Margin="0,0,0,8" Visibility="Collapsed"
                  Style="{DynamicResource WorkbenchComboBoxStyle}" SelectionChanged="SelectCategory"
                  AutomationProperties.Name="设置分类"/>
        <Grid Grid.Row="4" Background="{DynamicResource WorkbenchSidebar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Categories" Width="150" Margin="0,0,16,0" Background="{DynamicResource WorkbenchSidebar}"
                     BorderThickness="0" SelectionChanged="SelectCategory" AutomationProperties.Name="设置分类">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="11,0"/>
                        <Setter Property="Height" Value="41"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Foreground" Value="{DynamicResource WorkbenchText}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Item" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource WorkbenchPanel}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource WorkbenchAccent}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource WorkbenchTint}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <ScrollViewer x:Name="RowsScroll" Grid.Column="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel Margin="0,0,3,0">
                    <StackPanel x:Name="Rows"/>
                    <ContentPresenter x:Name="AgentRows" Content="{Binding AgentSettings, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <TextBlock x:Name="Empty" Visibility="Collapsed" Text="没有匹配的设置" Margin="12"
                               Foreground="{DynamicResource WorkbenchMuted}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="自动保存到本机 · 即时生效 · 不修改项目代码"
                   Foreground="{DynamicResource WorkbenchMuted}" FontWeight="Medium"/>
    </Grid>
</UserControl>
