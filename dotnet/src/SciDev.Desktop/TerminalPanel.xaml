<UserControl x:Class="SciDev.Desktop.TerminalPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SciDev.Desktop" Foreground="{DynamicResource WorkbenchText}">
    <DockPanel Background="{DynamicResource WorkbenchPanel}" Margin="7">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,7">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox x:Name="LineMode" Content="逐行输入" VerticalAlignment="Center" Margin="0,0,10,0"
                          Click="ToggleLineMode" IsEnabled="False"/>
                <Button x:Name="StartButton" Content="启动宿主终端" Click="StartTerminal" Padding="8,4"/>
                <Button x:Name="InterruptButton" Content="中断" Click="InterruptTerminal" Padding="8,4" Margin="5,0" IsEnabled="False"/>
                <Button x:Name="StopButton" Content="关闭" Click="StopTerminal" Padding="8,4" IsEnabled="False"/>
            </StackPanel>
            <TextBlock x:Name="Status" Text="PowerShell · 手动操作" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Margin="0,0,8,0" AutomationProperties.Name="终端状态"/>
        </DockPanel>
        <WrapPanel x:Name="DebugControls" DockPanel.Dock="Top" Margin="0,0,0,4" Visibility="Collapsed"
                   AutomationProperties.Name="Python 调试操作">
            <Button Content="继续 (F5)" Tag="c" Click="DebugCommand" Padding="8,4" Margin="0,0,4,3"/>
            <Button Content="单步跳过 (F10)" Tag="n" Click="DebugCommand" Padding="8,4" Margin="0,0,4,3"/>
            <Button Content="单步进入 (F11)" Tag="s" Click="DebugCommand" Padding="8,4" Margin="0,0,4,3"/>
            <Button Content="跳出函数" Tag="r" Click="DebugCommand" Padding="8,4" Margin="0,0,4,3"/>
            <Button Content="退出调试" Tag="q" Click="DebugCommand" Padding="8,4" Margin="0,0,0,3"/>
        </WrapPanel>
        <DockPanel x:Name="LineInput" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,7,0,0">
            <Button x:Name="SendButton" Content="发送" DockPanel.Dock="Right" Click="SendInput" Padding="10,4"
                    Margin="6,0,0,0" IsEnabled="False"/>
            <TextBox x:Name="CommandInput" FontFamily="Consolas" MaxLength="4096" KeyDown="InputKeyDown"
                     IsEnabled="False" AutomationProperties.Name="终端输入"/>
        </DockPanel>
        <Border BorderBrush="{DynamicResource WorkbenchEdge}" BorderThickness="1">
            <local:TerminalViewport x:Name="Screen" Focusable="True" FontFamily="Consolas" FontSize="14" Padding="8"
                 Foreground="{DynamicResource WorkbenchText}" Background="{DynamicResource WorkbenchSidebar}"
                 InputMethod.IsInputMethodEnabled="True" AutomationProperties.Name="交互终端"
                 ToolTip="滚轮查看历史。Ctrl+Shift+C 复制当前屏幕，Ctrl+Shift+V 粘贴。"
                 SizeChanged="ResizeTerminal" PreviewKeyDown="ScreenKeyDown" TextInput="ScreenTextInput"
                 PreviewMouseDown="ScreenMouseDown" PreviewMouseUp="ScreenMouseUp"
                 PreviewMouseMove="ScreenMouseMove" PreviewMouseWheel="ScreenWheel"/>
        </Border>
    </DockPanel>
</UserControl>
