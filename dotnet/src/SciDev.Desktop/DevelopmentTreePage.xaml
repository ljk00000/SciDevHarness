<UserControl x:Class="SciDev.Desktop.DevelopmentTreePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource WorkbenchText}" SizeChanged="AdaptLayout">
    <UserControl.Resources>
        <Style x:Key="VersionQuiet" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontWeight" Value="{DynamicResource WorkbenchControlWeight}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style x:Key="VersionMetric" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WorkbenchPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="VersionMetricValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="21"/>
        </Style>
        <Style x:Key="DevelopmentVersionCard" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{DynamicResource WorkbenchMuted}" CornerRadius="9" Opacity="0.12"
                                    RenderTransformOrigin="0,0">
                                <Border.RenderTransform><TranslateTransform X="4" Y="5"/></Border.RenderTransform>
                            </Border>
                            <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource WorkbenchGitAccent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource WorkbenchAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="5,0,0,0">
        <Border x:Name="PageHeader" DockPanel.Dock="Top" Height="68" Background="{DynamicResource WorkbenchPanel}"
                BorderBrush="{DynamicResource WorkbenchEdge}" BorderThickness="0,0,0,1" Padding="18,0,14,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ReturnButton" Content="返回编码工作区" Style="{StaticResource VersionQuiet}" Click="ReturnToEditor"/>
                    <Button x:Name="RefreshButton" Content="刷新树" Style="{StaticResource VersionQuiet}" Click="RefreshTree"/>
                    <Button x:Name="FitButton" Content="适应全图" Style="{StaticResource VersionQuiet}" Click="FitTree"/>
                    <Button Content="详情" ToolTip="显示或收起节点详情" Style="{StaticResource VersionQuiet}" Click="ToggleDetails"/>
                    <Button Content="Agent" ToolTip="显示或收起对话" Style="{StaticResource VersionQuiet}" Click="ToggleAgent"/>
                    <Button x:Name="GitButton" Content="初始化 Git" Style="{DynamicResource ClassicAction}" Margin="8,0,0,0"
                            Background="{DynamicResource WorkbenchGitAccent}" Foreground="{DynamicResource WorkbenchAccentText}"
                            BorderThickness="0" Padding="10,4" Click="OpenGit" IsEnabled="{Binding CanStart}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource WorkbenchAgentMark}" Width="32" Height="32" CornerRadius="5" Margin="0,0,6,0">
                        <TextBlock Text="G" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="开发版本树" FontWeight="{DynamicResource WorkbenchControlWeight}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="Subtitle" Text="主线与尝试方向 · 非 Git 分支" Foreground="{DynamicResource WorkbenchMuted}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        <UniformGrid x:Name="Metrics" DockPanel.Dock="Top" Columns="4" Height="67" Margin="18,6,8,8">
            <Border Style="{StaticResource VersionMetric}">
                <StackPanel>
                    <TextBlock x:Name="MainCount" Text="0" Style="{StaticResource VersionMetricValue}"/>
                    <TextBlock Text="主线" Foreground="{DynamicResource WorkbenchMuted}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource VersionMetric}">
                <StackPanel>
                    <TextBlock x:Name="AttemptCount" Text="0" Style="{StaticResource VersionMetricValue}"/>
                    <TextBlock Text="尝试" Foreground="{DynamicResource WorkbenchMuted}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource VersionMetric}">
                <StackPanel>
                    <TextBlock x:Name="FailedCount" Text="0" Style="{StaticResource VersionMetricValue}"/>
                    <TextBlock Text="失败" Foreground="{DynamicResource WorkbenchMuted}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource VersionMetric}">
                <StackPanel>
                    <TextBlock x:Name="Head" Text="暂无" Style="{StaticResource VersionMetricValue}"/>
                    <TextBlock Text="HEAD" Foreground="{DynamicResource WorkbenchMuted}"/>
                </StackPanel>
            </Border>
        </UniformGrid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="DetailsColumn" Width="305"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="DetailsRow" Height="0"/>
            </Grid.RowDefinitions>
            <Grid x:Name="GraphArea" ClipToBounds="True" SizeChanged="ResizeGraph">
                <ScrollViewer x:Name="GraphScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden"
                              PreviewMouseWheel="ZoomTree" PreviewMouseDown="BeginPan" PreviewMouseMove="Pan"
                              PreviewMouseUp="EndPan">
                    <ContentControl x:Name="GraphHost" HorizontalContentAlignment="Center" VerticalContentAlignment="Top"/>
                </ScrollViewer>
                <Border VerticalAlignment="Top" Height="52" Background="{DynamicResource WorkbenchSidebar}"
                        BorderBrush="{DynamicResource WorkbenchEdge}" BorderThickness="0,0,0,1" Padding="18,8" IsHitTestVisible="False">
                    <DockPanel>
                        <TextBlock x:Name="ZoomHint" DockPanel.Dock="Right" Text="100% · Ctrl+滚轮缩放 · 拖动分支 / 平移画布"
                                   Foreground="{DynamicResource WorkbenchMuted}" FontSize="12" Margin="10,1,0,0"/>
                        <StackPanel>
                            <TextBlock Text="开发尝试树" FontWeight="Bold"/>
                            <TextBlock Text="主干 = 当前编码主线 · 分支 = 已取消、失败或等待中的尝试方向"
                                       Foreground="{DynamicResource WorkbenchMuted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
            <DockPanel x:Name="Details" Grid.Column="1" Background="{DynamicResource WorkbenchTreeDetails}">
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource WorkbenchPanel}" Padding="17,10,12,12"
                        BorderBrush="{DynamicResource WorkbenchEdge}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,7">
                            <TextBox x:Name="CommitInput" Style="{DynamicResource SettingsTextInput}" Height="40" Padding="11,4"
                                     MaxLength="1000" KeyDown="SubmitMessage" AutomationProperties.Name="提交说明"/>
                            <TextBlock Text="提交说明" IsHitTestVisible="False" Margin="12,0,4,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource WorkbenchMuted}" Opacity="0.75">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CommitInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Content="提交暂存" Height="35" Style="{DynamicResource ClassicPrimary}"
                                Background="{DynamicResource WorkbenchGitAccent}" BorderBrush="{DynamicResource WorkbenchGitAccent}"
                                Click="CommitStaged" IsEnabled="{Binding CanStart}"/>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="23,17,16,12">
                        <TextBlock Text="节点详情" FontSize="13" Foreground="{DynamicResource WorkbenchMuted}"/>
                        <TextBlock x:Name="DetailTitle" FontWeight="Bold" FontSize="19" Margin="0,10,0,6" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailStatus" FontWeight="SemiBold"/>
                        <TextBlock x:Name="Description" Foreground="{DynamicResource WorkbenchMuted}" Margin="0,8,0,18" TextWrapping="Wrap"/>
                        <TextBlock Text="记录" FontSize="13" Foreground="{DynamicResource WorkbenchMuted}"/>
                        <TextBlock x:Name="Record" Foreground="{DynamicResource WorkbenchMuted}" Margin="0,7,0,9" TextWrapping="Wrap"/>
                        <Button x:Name="RetryButton" Content="重新尝试这个方向" Click="RetryVersion" IsEnabled="False" Height="35">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource VersionQuiet}">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource WorkbenchDisabled}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource WorkbenchDisabledText}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="工作区变更" FontSize="13" Foreground="{DynamicResource WorkbenchMuted}" Margin="0,9,0,8"/>
                        <ListBox x:Name="Changes" Height="120" Padding="7,5" DisplayMemberPath="Display"
                                 MouseDoubleClick="OpenChange" AutomationProperties.Name="工作区变更"/>
                        <Button Content="查看 Git 改动" Style="{DynamicResource ClassicQuiet}" Margin="0,6,0,0"
                                Click="OpenGitChanges" IsEnabled="{Binding CanStart}"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
