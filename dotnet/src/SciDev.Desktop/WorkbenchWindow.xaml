<Window x:Class="SciDev.Desktop.WorkbenchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:desktop="clr-namespace:SciDev.Desktop"
        xmlns:core="clr-namespace:SciDev.Core;assembly=SciDev.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SciDevHarness" Width="1280" Height="760" MinWidth="780" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize" FontFamily="Noto Sans SC, Microsoft YaHei UI, Segoe UI"
        FontSize="14.67" Background="{DynamicResource WorkbenchCanvas}" Foreground="{DynamicResource WorkbenchText}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Closing="OnClosing" PreviewKeyDown="QuickOpen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary Source="WorkbenchControls.xaml"/></Window.Resources>
    <Grid x:Name="Surface" Background="{DynamicResource WorkbenchCanvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="27"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource WorkbenchPanel}" BorderBrush="{DynamicResource WorkbenchEdge}"
                BorderThickness="0,0,0,1" MouseLeftButtonDown="DragTitleBar" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="110"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource WorkbenchAccent}" CornerRadius="5" Width="25" Height="25" Margin="0,0,10,0">
                        <TextBlock Text="S" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"
                                   Foreground="{DynamicResource WorkbenchAccentText}"/>
                    </Border>
                    <TextBlock Text="SciDevHarness" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Width="1" Height="17" Background="{DynamicResource WorkbenchMuted}" Margin="11,0,5,0"/>
                    <Button x:Name="WorkspaceButton" Click="OpenWorkspace" IsEnabled="{Binding CanStart}" MaxWidth="254"
                            Padding="5,0,9,0" Style="{StaticResource ClassicQuiet}" Foreground="{DynamicResource WorkbenchMuted}"
                            ToolTip="{Binding Workspace}" AutomationProperties.Name="切换工作区">
                        <TextBlock x:Name="WorkspaceCaption" Text="{Binding WorkspaceName}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="137"/>
                    </Button>
                </StackPanel>
                <Grid x:Name="CommandSearchRegion" Grid.Column="1" Margin="7,1,10,1" MaxWidth="395"
                      VerticalAlignment="Stretch" HorizontalAlignment="Left">
                    <TextBox x:Name="CommandSearch" Style="{StaticResource SettingsTextInput}" BorderThickness="1"
                             IsEnabled="{Binding CanStart}"
                             Background="{DynamicResource WorkbenchCanvas}" Padding="12,4" TextChanged="SearchWorkspace"
                             KeyDown="OpenSearchResult" AutomationProperties.Name="搜索工作区文件"/>
                    <TextBlock Text="搜索工作区文件…  Ctrl+P" Margin="13,0,3,0" IsHitTestVisible="False" VerticalAlignment="Center"
                               Foreground="{DynamicResource WorkbenchMuted}" Opacity="0.76" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CommandSearch}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="NewTaskButton" Content="新会话" Click="NewTask" IsEnabled="{Binding CanStart}"
                            Style="{StaticResource ClassicPrimary}" Margin="0,0,8,0" Height="35" MinWidth="69"/>
                    <Button x:Name="TitleVersionsButton" Content="版本树" Click="SelectGit" Style="{StaticResource ClassicPrimary}"
                            Background="{DynamicResource WorkbenchGitAccent}" BorderBrush="{DynamicResource WorkbenchGitAccent}"
                            Margin="0,0,6,0" Height="35" MinWidth="69"/>
                    <Button x:Name="RefreshWorkspaceButton" Content="刷新" Click="RefreshWorkbench" IsEnabled="{Binding CanStart}"
                            Style="{StaticResource ClassicQuiet}" Margin="0,0,6,0" MinWidth="58"/>
                    <Button x:Name="TitleThemeButton" Content="主题⌄" Click="ShowThemeMenu" Style="{StaticResource ClassicAction}" MinWidth="58"
                            Background="{DynamicResource WorkbenchTint}" MinHeight="26" Margin="0,0,17,0">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Paper · 明亮浅色" Tag="paper" Click="ChooseTheme"/>
                                <MenuItem Header="Studio · 深色工作台" Tag="studio" Click="ChooseTheme"/>
                                <MenuItem Header="Focus · 专注宽编辑器" Tag="focus" Click="ChooseTheme"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="−" Click="MinimizeWindow" Style="{StaticResource ClassicQuiet}" Width="42" ToolTip="最小化"/>
                    <Button Content="□" Click="MaximizeWindow" Style="{StaticResource ClassicQuiet}" Width="42" ToolTip="最大化或还原"/>
                    <Button Content="×" Click="CloseWindow" Style="{StaticResource ClassicAction}" Width="34" Margin="9,0,0,0"
                            Background="{DynamicResource WorkbenchCanvas}" Height="28" MinHeight="0" Padding="1" ToolTip="关闭"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" x:Name="WorkbenchGrid" SizeChanged="ClassicLayoutChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ActivityColumn" Width="76"/>
                <ColumnDefinition x:Name="EditorAreaColumn" Width="*"/>
                <ColumnDefinition x:Name="AgentHandleColumn" Width="5"/>
                <ColumnDefinition x:Name="AgentColumn" Width="*"/>
                <ColumnDefinition x:Name="ReaderHandleColumn" Width="0"/>
                <ColumnDefinition x:Name="ReaderColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource WorkbenchPanel}" BorderBrush="{DynamicResource WorkbenchEdge}" BorderThickness="0,0,1,0"
                    Padding="8,10,7,11">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Button x:Name="ExplorerRailButton" Style="{StaticResource ClassicRailAction}" Click="SelectExplorer"
                                ToolTip="工作区文件" AutomationProperties.Name="工作区文件">
                            <Path Data="M 2,7 H 10 L 12,10 H 24 L 22,23 H 3 Z" StrokeThickness="2.3"
                                  StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="SearchRailButton" Style="{StaticResource ClassicRailAction}" Click="FocusSearch" ToolTip="搜索" AutomationProperties.Name="搜索">
                            <Path Data="M 18,11 A 7,7 0 1 1 4,11 A 7,7 0 1 1 18,11 M 16,16 L 23,23" StrokeThickness="2.3"
                                  StrokeEndLineCap="Round" Stroke="{DynamicResource WorkbenchMuted}"/>
                        </Button>
                        <Button x:Name="GitRailButton" Style="{StaticResource ClassicRailAction}" Click="SelectGit"
                                ToolTip="版本树" AutomationProperties.Name="版本树">
                            <Path Data="M 6,4 V 23 M 6,10 C 6,15 17,10 18,18 M 9,4 A 3,3 0 1 1 3,4 A 3,3 0 1 1 9,4
                                        M 9,23 A 3,3 0 1 1 3,23 A 3,3 0 1 1 9,23 M 21,18 A 3,3 0 1 1 15,18 A 3,3 0 1 1 21,18"
                                  StrokeThickness="2.1" StrokeEndLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button x:Name="SettingsRailButton" Style="{StaticResource ClassicRailAction}" Click="OpenSettings" IsEnabled="{Binding CanStart}"
                                ToolTip="设置" AutomationProperties.Name="设置" Margin="0,0,0,8">
                            <Path Data="M 10,2 H 15 L 16,5 L 19,6 L 22,5 L 25,9 L 23,12 L 23,14 L 25,17 L 22,21 L 19,20 L 16,21
                                        L 15,24 H 10 L 9,21 L 6,20 L 3,21 L 0,17 L 2,14 L 2,12 L 0,9 L 3,5 L 6,6 L 9,5 Z
                                        M 17,13 A 4.5,4.5 0 1 1 8,13 A 4.5,4.5 0 1 1 17,13"
                                  StrokeThickness="1.95" StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Content="S" Click="SelectHistory" Style="{StaticResource ClassicPrimary}" Width="30" Height="30"
                                Padding="0" ToolTip="最近会话" AutomationProperties.Name="最近会话"/>
                    </StackPanel>
                    <Border/>
                </DockPanel>
            </Border>
            <TabControl x:Name="Views" Grid.Column="1" Style="{StaticResource ClassicPages}" SelectionChanged="ClassicPageChanged">
                <TabItem x:Name="DocumentsTab" Header="工作台">
                    <desktop:DocumentShelf x:Name="Documents" ActivePath="{Binding ActivePath, ElementName=Reader}"/>
                </TabItem>
                <TabItem x:Name="FilesTab" Header="文件">
                    <desktop:ProjectWorkspace x:Name="FileDesk" IsEnabled="{Binding CanStart}"
                                              SearchRequested="FocusSearch" TerminalRequested="SelectTerminal"/>
                </TabItem>
                <TabItem x:Name="GitTab" Header="版本树">
                    <desktop:DevelopmentTreePage x:Name="VersionsPage"/>
                </TabItem>
                <TabItem x:Name="GitChangesTab" Header="Git 改动">
                    <DockPanel>
                    <Button DockPanel.Dock="Top" Content="返回开发版本树" Click="SelectGit"
                            Style="{StaticResource ClassicQuiet}" HorizontalAlignment="Left" Margin="8,4"/>
                    <desktop:GitChangesPanel x:Name="GitDesk" IsEnabled="{Binding CanStart}"/>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="TerminalTab" Header="终端">
                    <desktop:TerminalPanel x:Name="TerminalDesk"/>
                </TabItem>
                <TabItem Header="设置" x:Name="SettingsTab">
                    <Grid x:Name="SettingsHost">
                        <desktop:ClassicSettingsPage x:Name="SettingsPage"/>
                        <StackPanel x:Name="AgentSettingsCards">
                            <Border x:Name="ModelSettingsCard" Style="{StaticResource SettingsCard}" IsEnabled="{Binding CanStart}">
                                <StackPanel>
                                    <TextBlock Text="模型连接" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WorkbenchText}" Margin="0,0,0,9"/>
                                    <Label Content="API 地址" Target="{Binding ElementName=ApiBaseInput}" Padding="0,0,0,4"/>
                                    <TextBox x:Name="ApiBaseInput" Text="{Binding ApiBase, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingsTextInput}"/>
                                    <Grid Margin="0,9,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Label Content="模型" Target="{Binding ElementName=ModelInput}" Padding="0,0,0,4"/>
                                            <TextBox x:Name="ModelInput" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource SettingsTextInput}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Label Content="API 密钥" Target="{Binding ElementName=Credential}" Padding="0,0,0,4"/>
                                            <PasswordBox x:Name="Credential" Style="{StaticResource SettingsPasswordInput}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="载入项目模型" Click="LoadProvider" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="PolicySettingsCard" Style="{StaticResource SettingsCard}" IsEnabled="{Binding CanStart}">
                                <StackPanel>
                                    <TextBlock Text="任务与权限" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WorkbenchText}" Margin="0,0,0,9"/>
                                    <WrapPanel Margin="0,0,0,7">
                                        <ComboBox Style="{StaticResource WorkbenchComboBoxStyle}" SelectedValuePath="Tag" SelectedValue="{Binding NetworkPolicy}"
                                                  MinWidth="112" Margin="0,0,8,4" IsEnabled="{Binding CanApproveOutside}"
                                                  AutomationProperties.Name="额外联网策略" ToolTip="此策略控制额外联网和宿主命令，模型连接使用配置的地址">
                                            <ComboBoxItem Tag="{x:Static core:AgentNetworkPolicy.Ask}">联网需审批</ComboBoxItem>
                                            <ComboBoxItem Tag="{x:Static core:AgentNetworkPolicy.Deny}">禁止额外联网</ComboBoxItem>
                                        </ComboBox>
                                        <Button Content="载入项目权限" Click="LoadLegacyPolicy" Margin="0,0,0,4"/>
                                        <ComboBox Style="{StaticResource WorkbenchComboBoxStyle}" SelectedValuePath="Tag"
                                                  SelectedValue="{Binding Planning}" MinWidth="112" Margin="8,0,0,4"
                                                  AutomationProperties.Name="任务计划模式">
                                            <ComboBoxItem Tag="{x:Static core:PlanningMode.Auto}">自动计划</ComboBoxItem>
                                            <ComboBoxItem Tag="{x:Static core:PlanningMode.Required}">要求计划</ComboBoxItem>
                                            <ComboBoxItem Tag="{x:Static core:PlanningMode.Off}">关闭计划</ComboBoxItem>
                                        </ComboBox>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,9">
                                        <CheckBox Content="区外文件审批" IsChecked="{Binding ApproveOutside}" IsEnabled="{Binding CanApproveOutside}" Margin="0,3,14,5"/>
                                        <CheckBox x:Name="NetworkApproval" Content="额外联网审批" IsChecked="{Binding ApproveNetwork}"
                                                  IsEnabled="{Binding CanApproveExtraNetwork}" Margin="0,3,14,5"
                                                  ToolTip="分别批准请求 HTTPS 地址和将预览发送给模型"/>
                                        <CheckBox Content="宿主命令审批" IsChecked="{Binding ApproveHostCommands}" IsEnabled="{Binding CanApproveExtraNetwork}"
                                                  Margin="0,3,14,5" ToolTip="逐次核对 Windows 程序。分享进程输出需再次审批。"/>
                                        <CheckBox Content="MCP 工具审批" IsChecked="{Binding ApproveMcp}" IsEnabled="{Binding CanApproveExtraNetwork}"
                                                  Margin="0,3,14,5" ToolTip="分别审批工具定义、调用和发送结果"/>
                                        <CheckBox Content="完成后提交" IsChecked="{Binding AutoCommit}" IsEnabled="{Binding CanApproveOutside}"
                                                  Margin="0,3,14,5" ToolTip="任务成功后审核并本地提交本轮文件"/>
                                    </WrapPanel>
                                    <Label Content="容器镜像（可选）" Target="{Binding ElementName=SandboxInput}" Padding="0,0,0,4"/>
                                    <TextBox x:Name="SandboxInput" Text="{Binding SandboxImage, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingsTextInput}"
                                             IsEnabled="{Binding CanApproveOutside}" ToolTip="留空可直接处理工作区文件。填写本机镜像可运行断网容器命令。"/>
                                    <CheckBox Content="容器内完成前验证" IsChecked="{Binding RequireVerification}" Margin="0,8,0,0"
                                              ToolTip="配置容器镜像后，代码任务需通过针对最终文件的离线验证。"/>
                                    <StackPanel Margin="0,8,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanEditAllowedCommands}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Label Content="容器命令白名单" Target="{Binding ElementName=AllowedCommandsInput}" Padding="0,0,0,4"/>
                                        <TextBox x:Name="AllowedCommandsInput" MaxLength="11000" Style="{StaticResource SettingsTextInput}"
                                                 Text="{Binding AllowedCommands, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="按参数前缀批准断网容器命令，多个前缀用分号分隔"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem x:Name="HistoryTab" Header="最近会话">
            <Border BorderBrush="{DynamicResource WorkbenchEdge}" BorderThickness="1" CornerRadius="14"
                    Background="{DynamicResource WorkbenchSidebar}" Padding="10">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Click="NewTask" IsEnabled="{Binding CanStart}"
                            Margin="1,2,1,15" MinHeight="38" AutomationProperties.Name="新任务">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 1,7 H 13 M 7,1 V 13" StrokeThickness="1.7" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Stroke="{DynamicResource WorkbenchAccent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="新任务" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <DockPanel DockPanel.Dock="Top" Margin="7,0,2,5">
                        <Button Style="{StaticResource SubtleAction}" Content="刷新" DockPanel.Dock="Right" Click="RefreshHistory"
                                IsEnabled="{Binding CanStart}" Padding="7,3" MinHeight="26" Foreground="{DynamicResource WorkbenchMuted}"/>
                        <TextBlock Text="最近会话" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                    </DockPanel>
                    <Button DockPanel.Dock="Top" x:Name="ResumePythonButton" Content="续跑 Python 会话" Click="ResumePython"
                            Margin="9,0,9,7" Padding="6,4" IsEnabled="{Binding CanStart}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem.Source, ElementName=History}" Value="python">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource WorkbenchEdge}" Padding="8" Margin="0,4,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasQueue}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="任务队列" FontWeight="SemiBold" Margin="1,0,0,4"/>
                            <ListBox x:Name="PendingTasks" ItemsSource="{Binding Queue}" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="任务队列" MaxHeight="116" MinHeight="32">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="5,3"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel ToolTip="{Binding Prompt}">
                                            <TextBlock Text="{Binding Prompt}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding State}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource WorkbenchMuted}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Margin="0,4,0,0">
                                <WrapPanel.Resources>
                                    <Style x:Key="SelectedTaskButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=PendingTasks}" Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Resources>
                                <Button Content="继续队列" Click="ContinueQueue" IsEnabled="{Binding CanContinueQueue}"
                                        ToolTip="按队列顺序执行。重开后，待确认的任务使用当前模型和权限。"
                                        Padding="7,3" Margin="0,2,4,0"/>
                                <Button Content="取回" Click="TakeTaskBack" Padding="7,3" Margin="0,2,4,0"
                                        Style="{StaticResource SelectedTaskButton}"
                                        ToolTip="从队列取回所选任务，放回输入框"/>
                                <Button Content="移除" Click="RemoveFromQueue" Padding="7,3" Margin="0,2,0,0"
                                        Style="{StaticResource SelectedTaskButton}"
                                        ToolTip="移除所选待处理任务"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Grid>
                    <ListBox x:Name="History" ItemsSource="{Binding History}" SelectionChanged="OpenHistory" IsEnabled="{Binding CanStart}"
                             BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource SessionRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="最近会话">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Task}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38"/>
                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource WorkbenchMuted}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="还没有会话" Foreground="{DynamicResource WorkbenchMuted}" Margin="8,9,0,0"
                               VerticalAlignment="Top" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=History}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>
                </TabItem>
            </TabControl>
            <GridSplitter x:Name="AgentSplitter" Grid.Column="2" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="{DynamicResource WorkbenchCanvas}" DragCompleted="AgentResized"/>
            <DockPanel x:Name="AgentPane" Grid.Column="3" Background="{DynamicResource WorkbenchCanvas}">
                <Border DockPanel.Dock="Top" Height="46" Padding="12,0" Background="{DynamicResource WorkbenchPanel}"
                        BorderThickness="0,0,0,1" BorderBrush="{DynamicResource WorkbenchEdge}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="···" Click="OpenAgentMenu" Style="{StaticResource ClassicQuiet}"
                                VerticalAlignment="Center" ToolTip="Agent 菜单" AutomationProperties.Name="Agent 菜单">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="模型设置" Click="OpenModelSettings"/>
                                    <MenuItem Header="任务与权限" Click="OpenTaskSettings"/>
                                    <MenuItem Header="最近会话" Click="SelectHistory"/>
                                    <Separator/>
                                    <MenuItem Header="代码编辑器" Click="OpenCodeEditor"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="ResumePreviewButton" DockPanel.Dock="Right" Content="查看预览" Click="ShowDocumentReader"
                                Style="{StaticResource ClassicQuiet}" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="24" Height="24" CornerRadius="7" Margin="0,0,8,0"
                                    Background="{DynamicResource WorkbenchTint}">
                                <TextBlock Text="✦" FontSize="13" Foreground="{DynamicResource WorkbenchAccent}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="AgentHeading" Text="Agent 工作台" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border x:Name="PlanRegion" DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource WorkbenchEdge}"
                        Background="{DynamicResource WorkbenchPanel}" Padding="12,5,12,5">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="PlanToggle" DockPanel.Dock="Right" Content="⌄" Width="28" Padding="0" MinHeight="29"
                                    Click="TogglePlan" Style="{StaticResource ClassicQuiet}" AutomationProperties.Name="展开或收起任务计划"/>
                            <ComboBox x:Name="PlanningPicker" DockPanel.Dock="Right" Style="{StaticResource WorkbenchComboBoxStyle}"
                                      SelectedValuePath="Tag" SelectedValue="{Binding Planning}" MinWidth="57" MinHeight="29"
                                      Margin="0,0,5,0" AutomationProperties.Name="任务计划模式">
                                <ComboBoxItem Tag="{x:Static core:PlanningMode.Auto}">自动</ComboBoxItem>
                                <ComboBoxItem Tag="{x:Static core:PlanningMode.Required}">要求</ComboBoxItem>
                                <ComboBoxItem Tag="{x:Static core:PlanningMode.Off}">关闭</ComboBoxItem>
                            </ComboBox>
                            <TextBlock Text="任务计划" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </DockPanel>
                        <Grid x:Name="PlanBody" Margin="0,4,0,0" Background="{DynamicResource WorkbenchSidebar}">
                            <TextBox Text="{Binding PlanText, Mode=OneWay}" Style="{StaticResource ConversationText}" MaxHeight="100"
                                     VerticalScrollBarVisibility="Auto" Padding="7,3" AutomationProperties.Name="计划步骤"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="AgentTopSpace" Height="0.85*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="AgentResultRow" Height="0"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="AgentBottomSpace" Height="1.15*"/>
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="AgentWelcome" Grid.Row="1" Margin="16,5,16,18" HorizontalAlignment="Center" MaxWidth="440">
                        <TextBlock Text="你想完成什么？" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,7" TextAlignment="Center"/>
                        <TextBlock Text="交给 Agent 一个任务，或打开工作区中的文档。" TextWrapping="Wrap"
                                   Foreground="{DynamicResource WorkbenchMuted}" TextAlignment="Center"/>
                        <Button Content="浏览工作区文件" Click="SelectExplorer" Style="{StaticResource ClassicQuiet}"
                                Foreground="{DynamicResource WorkbenchAccent}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                    <ScrollViewer x:Name="Transcript" Grid.Row="2" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto" Padding="15,16,15,10">
                        <StackPanel x:Name="ConversationContent" MaxWidth="820">
                            <Border x:Name="UserMessage" Style="{StaticResource WorkbenchCard}" Background="{DynamicResource WorkbenchTint}"
                                    BorderThickness="0" Padding="14,11" Margin="16,0,0,13" HorizontalAlignment="Right">
                                <StackPanel>
                                    <TextBlock Text="你" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="SubmittedTask" Text="{Binding SubmittedPrompt, Mode=OneWay}"
                                             Style="{StaticResource ConversationText}" AutomationProperties.Name="你的任务"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="AgentMessage" Style="{StaticResource WorkbenchCard}" Padding="14,11" Margin="0,0,16,12">
                                <StackPanel>
                                    <TextBlock Text="Agent" FontSize="12" Foreground="{DynamicResource WorkbenchMuted}" FontWeight="SemiBold"
                                               Margin="0,0,0,5"/>
                                    <TextBox x:Name="AgentResult" Text="{Binding Output, Mode=OneWay}" Style="{StaticResource ConversationText}"
                                             AutomationProperties.Name="任务结果"/>
                                    <TextBlock x:Name="AgentProgress" Text="{Binding Status}" Foreground="{DynamicResource WorkbenchMuted}"
                                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                    <ItemsControl x:Name="ArtifactCards" ItemsSource="{Binding PreviewPaths}" Margin="0,7,0,0"
                                                  AutomationProperties.Name="任务产物">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Tag="{Binding}" Click="OpenArtifact" ToolTip="{Binding}" Margin="0,3,7,3" Padding="9,5" MaxWidth="280">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource ClassicAction}">
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource SameDocument}">
                                                                            <Binding/>
                                                                            <Binding Path="ActivePath" ElementName="Reader"/>
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="Background" Value="{DynamicResource WorkbenchTint}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchAccent}"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource WorkbenchAccent}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="M 2,1 H 10 L 15,6 V 17 H 2 Z M 10,1 V 6 H 15 M 5,10 H 12 M 5,13 H 12"
                                                              Stroke="{DynamicResource WorkbenchAccent}" StrokeThickness="1.2" Margin="0,0,7,0"/>
                                                        <TextBlock Text="{Binding}" MaxWidth="231" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Border x:Name="ComposerRegion" Grid.Row="3" MaxWidth="820" Margin="15,0,15,15" Padding="9,7"
                            Style="{StaticResource WorkbenchCard}">
                        <StackPanel x:Name="ComposerContent">
                            <Grid>
                                <TextBox x:Name="PromptInput" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ClassicComposerInput}" BorderThickness="0" Background="Transparent"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="72" Padding="6,7"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                         AllowDrop="True" PreviewDragOver="DragTaskImage" PreviewDrop="DropTaskImage"
                                         AutomationProperties.Name="任务描述"/>
                                <TextBlock Text="告诉 Agent 你想完成什么…" IsHitTestVisible="False"
                                           Foreground="{DynamicResource WorkbenchMuted}" Margin="7,7,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Prompt}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <DockPanel Margin="0,4,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ComposerModelButton" Click="OpenModelSettings" Padding="8,3" Margin="2,0,0,0"
                                            ToolTip="{Binding ModelLabel}" AutomationProperties.Name="模型连接设置">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ClassicQuiet}">
                                                <Setter Property="IsEnabled" Value="{Binding CanStart}"/>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="配置模型"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource WorkbenchAccent}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasModelAddress}" Value="True">
                                                            <Setter Property="Text" Value="{Binding ModelLabel}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource WorkbenchMuted}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                    <Button Content="停止" Click="StopTask" Margin="2,0,0,0" Padding="8,3">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ClassicQuiet}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger></Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button x:Name="SubmitTaskButton" Content="{Binding SubmitLabel}" Click="RunTask"
                                            Style="{StaticResource ClassicPrimary}" MinHeight="33" Padding="12,3" Margin="4,0,0,0"
                                            ToolTip="Ctrl + Enter"/>
                                </StackPanel>
                                <WrapPanel VerticalAlignment="Center">
                                    <ComboBox x:Name="ModePicker" Style="{StaticResource WorkbenchComboBoxStyle}" SelectedValuePath="Tag"
                                              SelectedValue="{Binding Mode}" MinWidth="60" MinHeight="30" Margin="0,1,3,1"
                                              IsEnabled="{Binding CanStart}" AutomationProperties.Name="执行权限" ToolTip="执行权限">
                                        <ComboBoxItem Tag="{x:Static core:ExecutionMode.WorkspaceApproval}">Agent</ComboBoxItem>
                                        <ComboBoxItem Tag="{x:Static core:ExecutionMode.WorkspaceWrite}">工作区可写</ComboBoxItem>
                                        <ComboBoxItem Tag="{x:Static core:ExecutionMode.Manual}">手动审批</ComboBoxItem>
                                        <ComboBoxItem Tag="{x:Static core:ExecutionMode.ReadOnly}">只读</ComboBoxItem>
                                        <ComboBoxItem Tag="{x:Static core:ExecutionMode.FullAccess}">完全访问</ComboBoxItem>
                                    </ComboBox>
                                    <Button Content="＋ 图片" Click="ChooseTaskImages" Style="{StaticResource ClassicQuiet}"
                                            AutomationProperties.Name="附加图片" Padding="5,3" ToolTip="选择图片，或拖放、粘贴到任务框。"/>
                                    <Button Content="清空图片" Click="ClearTaskImages" Style="{StaticResource ClassicQuiet}"
                                            IsEnabled="{Binding HasImages}" ToolTip="{Binding ImageNames}" Padding="5,3">
                                        <Button.Visibility>
                                            <Binding Path="HasImages"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding>
                                        </Button.Visibility>
                                    </Button>
                                </WrapPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <GridSplitter x:Name="ReaderSplitter" Grid.Column="4" Visibility="Collapsed" ResizeBehavior="PreviousAndNext"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource WorkbenchEdge}"/>
            <desktop:DocumentPreview x:Name="Reader" Grid.Column="5" Visibility="Collapsed"/>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource WorkbenchPanel}" Padding="8,0"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WorkbenchEdge}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GitStatus, ElementName=GitDesk}" Margin="0,0,20,0" Foreground="{DynamicResource WorkbenchMuted}"/>
                    <StackPanel x:Name="CodeStatus" Orientation="Horizontal">
                        <TextBlock Text="{Binding CaretStatus, ElementName=FileDesk}" Margin="0,0,20,0" Foreground="{DynamicResource WorkbenchMuted}"/>
                        <TextBlock Text="UTF-8" Margin="0,0,20,0" Foreground="{DynamicResource WorkbenchMuted}"/>
                        <TextBlock Text="{Binding EditorLanguageLabel, ElementName=FileDesk}" Margin="0,0,15,0" Foreground="{DynamicResource WorkbenchMuted}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource WorkbenchMuted}" AutomationProperties.Name="运行状态"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
