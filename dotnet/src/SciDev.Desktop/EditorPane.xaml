<UserControl x:Class="SciDev.Desktop.EditorPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editor="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
             GotKeyboardFocus="FocusPane" PreviewMouseLeftButtonDown="ClickPane">
    <Border x:Name="PaneFrame" BorderThickness="0,2,0,0" BorderBrush="{DynamicResource WorkbenchEdge}">
        <DockPanel>
            <ListBox x:Name="FileTabs" DockPanel.Dock="Top" BorderThickness="0"
                     BorderBrush="{DynamicResource WorkbenchEdge}" Padding="0" MinHeight="42"
                     Background="{DynamicResource WorkbenchPanel}" SelectionChanged="SelectTab"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="打开的文件">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource WorkbenchText}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Tab" Background="{DynamicResource WorkbenchPanel}" Padding="14,5"
                                            BorderBrush="{DynamicResource WorkbenchEdge}" BorderThickness="0,0,1,0" MinHeight="42">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Tab" Property="Background" Value="{DynamicResource WorkbenchCanvas}"/>
                                            <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource WorkbenchAccent}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource WorkbenchAccent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="×" Click="CloseTab" Style="{DynamicResource ClassicQuiet}"
                                    Padding="3,0" MinHeight="21" Margin="8,0,-4,0" Foreground="{DynamicResource WorkbenchMuted}" ToolTip="关闭文件"/>
                            <TextBlock Text="{Binding Caption}" ToolTip="{Binding Path}" MaxWidth="160" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Background="{DynamicResource WorkbenchCanvas}" Padding="18,14,17,13">
                <Grid>
                    <Border Width="42" HorizontalAlignment="Left" Background="{DynamicResource WorkbenchEditorGutter}"/>
                <editor:TextEditor x:Name="Code" FontFamily="Consolas, Cascadia Mono" FontSize="16" ShowLineNumbers="True"
                                   Background="Transparent" Foreground="{DynamicResource WorkbenchText}"
                                   LineNumbersForeground="{DynamicResource WorkbenchMuted}" IsReadOnly="True"
                                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                   AutomationProperties.Name="源文件编辑器"/>
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
