<Window x:Class="SciDev.Desktop.GitCommitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提交暂存文件" Width="620" Height="520" MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WorkbenchPanel}" Foreground="{DynamicResource WorkbenchText}" FontSize="13">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TargetBranch" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,5"/>
            <TextBlock Text="需要签名或提交钩子时，请使用本地 Git。" Foreground="{DynamicResource WorkbenchMuted}"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,9,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <Label Padding="0,0,0,4" Content="提交者姓名" Target="{Binding ElementName=AuthorName}"/>
                    <TextBox x:Name="AuthorName" MaxLength="256"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <Label Padding="0,0,0,4" Content="提交者邮箱" Target="{Binding ElementName=AuthorEmail}"/>
                    <TextBox x:Name="AuthorEmail" MaxLength="256"/>
                </StackPanel>
            </Grid>
            <Label Padding="0,9,0,4" Content="提交说明" Target="{Binding ElementName=CommitMessage}"/>
            <TextBox x:Name="CommitMessage" Height="72" AcceptsReturn="True" MaxLength="8192"
                     TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
            <TextBlock x:Name="Validation" Foreground="{DynamicResource WorkbenchMuted}" Margin="0,7,0,0" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="取消" IsCancel="True" Margin="0,0,7,0"/>
                <Button Content="提交" Click="Confirm" Background="{DynamicResource WorkbenchAccent}" Foreground="{DynamicResource WorkbenchAccentText}"/>
            </StackPanel>
        </StackPanel>
        <ListBox x:Name="StagedPaths" AutomationProperties.Name="暂存文件" IsTabStop="False"
                 BorderBrush="{DynamicResource WorkbenchEdge}" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
    </DockPanel>
</Window>
