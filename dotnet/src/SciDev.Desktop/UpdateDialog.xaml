<Window x:Class="SciDev.Desktop.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SciDevHarness 更新" Width="680" Height="480" MinWidth="445" MinHeight="375"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" FontSize="13"
        Background="{DynamicResource WorkbenchPanel}" Foreground="{DynamicResource WorkbenchText}">
    <Grid x:Name="Surface" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <TextBlock x:Name="VersionLabel" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="ReleaseRepo" Margin="0,4,0,6" TextWrapping="Wrap"/>
            <CheckBox x:Name="AllowNetwork" Content="申请覆盖断网策略" Click="NetworkChanged"/>
        </StackPanel>
        <TextBlock Grid.Row="1" x:Name="AssetLabel" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <TextBox Grid.Row="2" x:Name="Notes" IsReadOnly="True" Padding="8" TextWrapping="Wrap"
                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="发布说明"/>
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <DockPanel x:Name="DigestField" Visibility="Collapsed" Margin="0,0,0,5">
                <Label Content="SHA-256" Target="{Binding ElementName=Digest}" Padding="0,0,8,0" VerticalAlignment="Center"/>
                <TextBox x:Name="Digest" MaxLength="75" TextChanged="DigestChanged"/>
            </DockPanel>
            <ProgressBar x:Name="Transfer" Height="4" Visibility="Collapsed"/>
            <TextBlock x:Name="Status" Margin="0,5,0,0" TextWrapping="Wrap" MaxHeight="52"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                       AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <WrapPanel Grid.Row="4" Margin="0,8,0,0" HorizontalAlignment="Right">
            <Button x:Name="CheckButton" Content="检查更新" Click="CheckClicked" Margin="0,2,6,0"/>
            <Button x:Name="DownloadButton" Content="下载安装包" Click="DownloadClicked" Margin="0,2,6,0"/>
            <Button x:Name="InstallButton" Content="启动安装器" Click="InstallClicked" Margin="0,2,6,0"/>
            <Button x:Name="CloseButton" Content="关闭" Click="CloseClicked" Margin="0,2,0,0"/>
        </WrapPanel>
    </Grid>
</Window>
