<UserControl x:Class="SciDev.Desktop.GitChangesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource WorkbenchText}">
    <Grid Background="{DynamicResource WorkbenchPanel}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="33*" MinWidth="120" MaxWidth="270"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="67*" MinWidth="160"/>
        </Grid.ColumnDefinitions>
        <DockPanel Background="{DynamicResource WorkbenchSidebar}">
            <DockPanel DockPanel.Dock="Top" Margin="8,6">
                <Button Content="查看状态" DockPanel.Dock="Right" Click="Refresh" Padding="7,3"/>
                <TextBlock x:Name="Branch" Text="Git" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,0,5,0"/>
            </DockPanel>
            <ListBox x:Name="Changes" SelectionChanged="SelectChange" DisplayMemberPath="Display" BorderThickness="0"
                     Background="{DynamicResource WorkbenchSidebar}" AutomationProperties.Name="Git 改动"/>
        </DockPanel>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource WorkbenchEdge}"/>
        <DockPanel Grid.Column="2" Margin="7">
            <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
                <Button x:Name="InitializeButton" Content="初始化 Git" Click="InitializeGit" Visibility="Collapsed" Padding="9,4" Margin="0,0,5,0"/>
                <Button x:Name="StageButton" Content="暂存" Click="Stage" IsEnabled="False" Padding="9,4" Margin="0,0,5,0"/>
                <Button x:Name="UnstageButton" Content="取消暂存" Click="Unstage" IsEnabled="False" Padding="9,4" Margin="0,0,5,0"/>
                <Button x:Name="StageAllButton" Content="暂存可见改动" Click="StageAll" IsEnabled="False" Padding="9,4" Margin="0,0,5,0"/>
                <Button x:Name="CommitButton" Content="提交暂存" Click="CommitStaged" IsEnabled="False" Padding="9,4"/>
                <Button x:Name="WorktreesButton" Content="工作树" Click="OpenWorktrees" IsEnabled="False" Padding="9,4" Margin="5,0,0,0"/>
                <Button x:Name="PullRequestsButton" Content="GitHub PR" Click="OpenPullRequests" IsEnabled="False" Padding="9,4" Margin="5,0,0,0"/>
            </WrapPanel>
            <TextBlock x:Name="Notice" Text="选择改动查看差异" DockPanel.Dock="Top" Margin="0,2,0,7"
                       TextTrimming="CharacterEllipsis" AutomationProperties.Name="Git 查询状态"/>
            <TextBox x:Name="Patch" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                     VerticalContentAlignment="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Git 文件差异"/>
        </DockPanel>
    </Grid>
</UserControl>
