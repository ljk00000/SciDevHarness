<Window x:Class="SciDev.Desktop.GitWorktreesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Git 工作树" Width="650" Height="410" MinWidth="435" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WorkbenchPanel}" Foreground="{DynamicResource WorkbenchText}" FontSize="13">
    <DockPanel Margin="16">
        <TextBlock x:Name="Repository" DockPanel.Dock="Top" Margin="0,0,0,8"
                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,9,0,0">
            <TextBlock x:Name="Notice" Margin="0,0,0,7" TextWrapping="Wrap"
                       Foreground="{DynamicResource WorkbenchMuted}" AutomationProperties.Name="工作树操作状态"/>
            <DockPanel>
                <Button x:Name="CreateButton" Content="新建并打开" Click="Create" DockPanel.Dock="Right" Margin="6,0,0,0"/>
                <Label Content="新工作树 ID" Target="{Binding ElementName=WorktreeId}" DockPanel.Dock="Left" Padding="0,6,8,0"/>
                <TextBox x:Name="WorktreeId" MaxLength="40" ToolTip="创建 scidev/agent-&lt;id&gt; 分支"/>
            </DockPanel>
            <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="关闭" IsCancel="True" Margin="0,0,6,0"/>
                <Button x:Name="RefreshButton" Content="刷新列表" Click="Refresh" Margin="0,0,6,0"/>
                <Button x:Name="OpenButton" Content="打开选中" Click="OpenSelected" IsEnabled="False" Margin="0,0,6,0"/>
                <Button x:Name="RemoveButton" Content="回收" Click="RemoveSelected" IsEnabled="False"
                        ToolTip="仅回收干净且已关闭的托管工作树，保留分支"/>
            </WrapPanel>
        </StackPanel>
        <ListBox x:Name="Worktrees" DisplayMemberPath="Display" SelectionChanged="SelectWorktree"
                 AutomationProperties.Name="已登记的工作树" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
    </DockPanel>
</Window>
